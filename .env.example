# Modelo no formato "provedor/modelo" do Mastra.
# Padrão: Gemini Flash (tem plano gratuito). Alternativa: anthropic/claude-haiku-5-5
LLM_MODEL=google/gemini-3.5-flash

# Chave do provedor escolhido. Gemini: crie em https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# ANTHROPIC_API_KEY=

# Serviço de chamados (SQLite). Padrão: packages/tickets-service/data/tickets.db
# TICKETS_DB_URL=file:./data/tickets.db

# Instabilidade simulada do sistema legado (0 desliga).
# Chance de cada chamada derrubar o sistema e por quanto tempo ele fica fora.
TICKETS_OUTAGE_RATE=0.05
TICKETS_OUTAGE_MS=1500
