# Copie para .env e preencha. O .env não vai para o Git.

# ---------- Modelo ----------
# Formato "provedor/modelo" do Mastra. Trocar de modelo ou de provedor é só mudar aqui.
#   google/gemini-3.5-flash       plano gratuito (limites baixos: ~5 req/min, ~20 req/dia)
#   anthropic/claude-haiku-5-5    pago, centavos por conversa; recomendado para o deploy
LLM_MODEL=google/gemini-3.5-flash

# Chave do provedor escolhido em LLM_MODEL (só a dele é obrigatória).
# Gemini: https://aistudio.google.com/api-keys   ·   Anthropic: https://platform.claude.com
GOOGLE_GENERATIVE_AI_API_KEY=
# ANTHROPIC_API_KEY=

# ---------- Servidor ----------
# Porta do api (o web usa PORT, padrão 3000, e repassa /api para cá).
API_PORT=3001
# Endereço do api visto pelo Next (usado no build do web).
# API_URL=http://localhost:3001

# Assina o cookie de sessão. Obrigatório em produção (NODE_ENV=production), mínimo 32 caracteres.
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# ---------- Bancos (SQLite) ----------
# Padrão: packages/tickets-service/data/tickets.db e apps/api/data/app.db
# TICKETS_DB_URL=file:/caminho/tickets.db
# APP_DB_URL=file:/caminho/app.db

# ---------- Sistema de chamados legado (simulado) ----------
# Chance de cada chamada derrubar o sistema e por quanto tempo ele fica fora (0 desliga).
TICKETS_OUTAGE_RATE=0.05
TICKETS_OUTAGE_MS=1500

# ---------- Limites de uso (proteção de custo no deploy) ----------
RATE_LIMIT_MESSAGES_PER_10MIN=20
DAILY_MESSAGE_CAP=500
RATE_LIMIT_LOGINS_PER_MINUTE=10
